{
   "$id": "https://silentarctic.github.io/schemas/career_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Career name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "skills": {
            "type": "array",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Skill name."
                  },
                  "source": {
                     "type": "string",
                     "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                     "x-hb": { "span": 1 }
                  }
               },
               "required": [
                  "name"
               ],
               "optional": [
                  "source"
               ],
               "additionalProperties": false
            },
            "description": "Career skills."
         },
         "description": {
            "type": "array",
            "x-hb": { "widget": "paragraphs" },
            "items": {
               "type": "string"
            },
            "description": "Career description."
         },
         "startingGear": {
            "type": "object",
            "properties": {
               "description": {
                  "type": "array",
                  "x-hb": { "widget": "paragraphs" },
                  "items": {
                     "type": "string"
                  },
                  "description": "Intro text for the starting gear."
               },
               "gear": {
                  "type": "array",
                  "items": {
                     "type": "string"
                  },
                  "description": "Starting gear, as display text."
               },
               "selections": {
                  "type": "array",
                  "description": "Starting gear the character sheet hands out. Each entry is an item, a choice, or a bundle.",
                  "items": {
                     "oneOf": [
                        {
                           "type": "object",
                           "title": "Item",
                           "description": "A single item, given by default.",
                           "properties": {
                              "name": {
                                 "type": "string",
                                 "description": "Gear name."
                              },
                              "quantity": {
                                 "type": "number",
                                 "description": "How many."
                              },
                              "money": {
                                 "type": "boolean",
                                 "description": "Whether this is starting money."
                              },
                              "formula": {
                                 "type": "string",
                                 "description": "Dice formula for starting money (example: 1d100 + 100)."
                              },
                              "source": {
                                 "type": "string",
                                 "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                                 "x-hb": { "span": 1 }
                              }
                           },
                           "required": [
                              "name"
                           ],
                           "optional": [
                              "quantity",
                              "money",
                              "formula",
                              "source"
                           ],
                           "additionalProperties": false
                        },
                        {
                           "type": "array",
                           "title": "Choice group",
                           "description": "Sets of items. The character picks one set.",
                           "minItems": 1,
                           "items": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                 "type": "object",
                                 "properties": {
                                    "name": {
                                       "type": "string",
                                       "description": "Gear name."
                                    },
                                    "quantity": {
                                       "type": "number",
                                       "description": "How many."
                                    },
                                    "money": {
                                       "type": "boolean",
                                       "description": "Whether this is starting money."
                                    },
                                    "formula": {
                                       "type": "string",
                                       "description": "Dice formula for starting money (example: 1d100 + 100)."
                                    },
                                    "source": {
                                       "type": "string",
                                       "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                                       "x-hb": { "span": 1 }
                                    }
                                 },
                                 "required": [
                                    "name"
                                 ],
                                 "optional": [
                                    "quantity",
                                    "money",
                                    "formula",
                                    "source"
                                 ],
                                 "additionalProperties": false
                              }
                           }
                        },
                        {
                           "type": "array",
                           "title": "Bundle",
                           "description": "A bundle of items received together.",
                           "minItems": 1,
                           "items": {
                              "type": "object",
                              "properties": {
                                 "name": {
                                    "type": "string",
                                    "description": "Gear name."
                                 },
                                 "quantity": {
                                    "type": "number",
                                    "description": "How many."
                                 },
                                 "money": {
                                    "type": "boolean",
                                    "description": "Whether this is starting money."
                                 },
                                 "formula": {
                                    "type": "string",
                                    "description": "Dice formula for starting money (example: 1d100 + 100)."
                                 },
                                 "source": {
                                    "type": "string",
                                    "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                                    "x-hb": { "span": 1 }
                                 }
                              },
                              "required": [
                                 "name"
                              ],
                              "optional": [
                                 "quantity",
                                 "money",
                                 "formula",
                                 "source"
                              ],
                              "additionalProperties": false
                           }
                        }
                     ]
                  }
               }
            },
            "description": "Suggested starting gear.",
            "required": [
               "description",
               "gear"
            ],
            "additionalProperties": false
         },
         "usefulTalents": {
            "type": "object",
            "properties": {
               "description": {
                  "type": "array",
                  "x-hb": { "widget": "paragraphs" },
                  "items": {
                     "type": "string"
                  },
                  "description": "Intro text for the suggested talents."
               },
               "talents": {
                  "type": "array",
                  "description": "Suggested talents.",
                  "items": {
                     "type": "object",
                     "properties": {
                        "tier": {
                           "type": "integer",
                           "minimum": 1,
                           "maximum": 5,
                           "description": "Talent tier."
                        },
                        "name": {
                           "type": "string",
                           "description": "Talent name."
                        },
                        "source": {
                           "type": "string",
                           "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                           "x-hb": { "span": 1 }
                        }
                     },
                     "required": [
                        "tier",
                        "name"
                     ],
                     "optional": [
                        "source"
                     ],
                     "additionalProperties": false
                  }
               }
            },
            "description": "Suggested starting talents.",
            "required": [
               "description",
               "talents"
            ],
            "additionalProperties": false
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "skills",
         "description"
      ],
      "optional": [
         "startingGear",
         "usefulTalents",
         "page",
         "settings"
      ],
      "additionalProperties": false
   }
}