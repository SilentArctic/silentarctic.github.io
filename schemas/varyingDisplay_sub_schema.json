{
   "$id": "https://silentarctic.github.io/schemas/varyingDisplay_sub_schema.json",
   "type": "array",
   "items": {
      "oneOf": [
         {
            "title": "String",
            "type": "string",
            "description": "A paragraph of text."
         },

         {
            "title": "Advanced Text",
            "type": "object",
            "description": "Titled block of entries. The type sets the style.",
            "properties": {
               "type": {
                  "type": "string",
                  "description": "Display style.",
                  "enum": [
                     "text",
                     "sidebar",
                     "example",
                     "read-aloud",
                     "codeblock"
                  ]
               },
               "title": {
                  "type": "string",
                  "description": "Heading."
               },
               "forceTitleLevel": {
                  "title": "Title level",
                  "type": "integer",
                  "description": "Heading level override. 1 is a chapter heading, 2 a section heading, and so on."
               },
               "page": {
                  "type": "integer",
                  "description": "Source page number."
               },
               "hasModal": {
                  "title": "Opens as modal",
                  "type": "boolean",
                  "description": "Whether clicking the block opens it in a modal. Rarely needed."
               },
               "entries": {
                  "$ref": "varyingDisplay_sub_schema.json",
                  "description": "Content of the block."
               },
               "_ref": {
                  "type": "object",
                  "description": "Shows an existing item of this type instead of writing it out (example: a sidebar).",
                  "properties": {
                     "name": {
                        "type": "string",
                        "description": "Item name."
                     },
                     "source": {
                        "type": "string",
                        "description": "Source abbreviation (example: CRB). Defaults to this content pack.",
                        "x-hb": { "span": 1 }
                     }
                  },
                  "required": [
                     "name"
                  ],
                  "optional": [
                     "source"
                  ],
                  "additionalProperties": false
               }
            },
            "required": [
               "entries"
            ],
            "optional": [
               "type",
               "title",
               "page",
               "forceTitleLevel",
               "hasModal",
               "_ref"
            ],
            "additionalProperties": false
         },

         {
            "title": "Notice",
            "type": "object",
            "description": "Colored callout box.",
            "properties": {
               "type": {
                  "type": "string",
                  "enum": ["notice"]
               },
               "variant": {
                  "type": "string",
                  "description": "Color. info is blue (default), success green, warn yellow, error red.",
                  "enum": [
                     "info",
                     "success",
                     "warn",
                     "error"
                  ]
               },
               "entries": {
                  "type": "array",
                  "description": "Notice text.",
                  "items": {
                     "type": "string",
                     "description": "Notice text."
                  }
               }
            },
            "required": [
               "type",
               "entries"
            ],
            "optional": [
               "variant"
            ],
            "additionalProperties": false
         },

         {
            "title": "Quote",
            "type": "object",
            "description": "Quoted text with an attribution.",
            "properties": {
               "type": {
                  "type": "string",
                  "enum": ["quote"]
               },
               "entries": {
                  "type": "array",
                  "description": "Quote text.",
                  "items": {
                     "type": "string",
                     "description": "Quote text."
                  }
               },
               "by": {
                  "type": "string",
                  "description": "Who said it.",
                  "x-hb": { "span": 1 }
               }
            },
            "required": [
               "type",
               "entries"
            ],
            "optional": [
               "by"
            ],
            "additionalProperties": false
         },

         {
            "title": "List",
            "type": "object",
            "description": "List of items, bulleted by default.",
            "properties": {
               "type": {
                  "type": "string",
                  "enum": ["list", "list-no-bullet"],
                  "description": "list-no-bullet hides the bullets."
               },
               "title": {
                  "type": "string",
                  "description": "Title above the list."
               },
               "description": {
                  "type": "string",
                  "description": "Text between the title and the list.",
                  "x-hb": { "span": "full" }
               },
               "items": {
                  "type": "array",
                  "description": "List items. Use a list object for a nested list.",
                  "items": {
                     "oneOf": [
                        {
                           "title": "Text",
                           "type": "string",
                           "description": "List item."
                        },
                        {
                           "title": "List",
                           "type": "object",
                           "description": "A nested list.",
                           "properties": {
                              "type": {
                                 "type": "string",
                                 "enum": ["list", "list-no-bullet"],
                                 "description": "list-no-bullet hides the bullets."
                              },
                              "title": {
                                 "type": "string",
                                 "description": "Title above the list."
                              },
                              "description": {
                                 "type": "string",
                                 "description": "Text between the title and the list.",
                                 "x-hb": { "span": "full" }
                              },
                              "items": {
                                 "type": "array",
                                 "description": "List items. Use a list object for a nested list.",
                                 "items": {
                                    "type": "string",
                                    "description": "List item."
                                 }
                              }
                           },
                           "required": [
                              "type",
                              "items"
                           ],
                           "optional": [
                              "title",
                              "description"
                           ],
                           "additionalProperties": false
                        }
                     ]
                  }
               }
            },
            "required": [
               "type",
               "items"
            ],
            "optional": [
               "title",
               "description"
            ],
            "additionalProperties": false
         },

         {
            "title": "Table",
            "type": "object",
            "description": "A table written inline, or an existing one shown by _ref.",
            "properties": {
               "type": {
                  "type": "string",
                  "enum": ["table"]
               },
               "page": {
                  "type": "integer",
                  "description": "Source page number."
               },
               "title": {
                  "type": "string",
                  "description": "Table title."
               },
               "subtitle": {
                  "type": "string",
                  "description": "Text above the table."
               },
               "foot": {
                  "type": "string",
                  "description": "Text below the table."
               },
               "columns": {
                  "type": "array",
                  "description": "Table columns.",
                  "items": {
                     "type": "object",
                     "properties": {
                        "header": {
                           "type": "string",
                           "description": "Column heading."
                        },
                        "value": {
                           "type": "string",
                           "description": "Row key for this column. Defaults to the header (case-insensitive)."
                        },
                        "size": {
                           "type": "integer",
                           "description": "Relative width. Sizes 2, 3, 3 give widths of 2/8, 3/8, 3/8."
                        }
                     },
                     "required": [
                        "header"
                     ],
                     "optional": [
                        "value",
                        "size"
                     ],
                     "additionalProperties": false
                  }
               },
               "rows": {
                  "type": "array",
                  "description": "One object per row, keyed by column value. A \"subtitle\" key renders a subtitle row.",
                  "x-hb": { "widget": "tableRows" },
                  "items": { "$ref": "tableRow_sub_schema.json" }
               },
               "_ref": {
                  "type": "object",
                  "description": "Shows an existing item of this type instead of writing it out (example: a sidebar).",
                  "properties": {
                     "name": {
                        "type": "string",
                        "description": "Table name."
                     },
                     "source": {
                        "type": "string",
                        "description": "Source abbreviation (example: CRB). Defaults to this content pack.",
                        "x-hb": { "span": 1 }
                     }
                  },
                  "required": [
                     "name"
                  ],
                  "optional": [
                     "source"
                  ],
                  "additionalProperties": false
               }
            },
            "required": [
               "type",
               "columns",
               "rows"
            ],
            "optional": [
               "title",
               "subtitle",
               "foot",
               "_ref"
            ],
            "additionalProperties": false
         },

         {
            "title": "Grid",
            "type": "object",
            "description": "Masonry layout. Arranges entries into columns.",
            "properties": {
               "type": {
                  "type": "string",
                  "enum": ["grid"]
               },
               "columns": {
                  "type": "integer",
                  "description": "Number of columns."
               },
               "entries": {
                  "$ref": "varyingDisplay_sub_schema.json",
                  "description": "Grid content. Each entry is one cell."
               }
            },
            "required": [
               "type",
               "columns",
               "entries"
            ],
            "additionalProperties": false
         },

         {
            "title": "Image",
            "type": "object",
            "description": "Displays an image.",
            "properties": {
               "type": {
                  "type": "string",
                  "enum": ["image"]
               },
               "imageUrl": {
                  "title": "Image URL",
                  "type": "string",
                  "description": "Image URL.",
                  "x-hb": { "span": "full" }
               },
               "height": {
                  "type": "string",
                  "description": "Maximum display height as a CSS length (example: 400px). The image keeps its aspect ratio."
               },
               "width": {
                  "type": "string",
                  "description": "Maximum display width as a CSS length (example: 400px or 50%). The image keeps its aspect ratio."
               }
            },
            "required": [
               "type",
               "imageUrl"
            ]
         },

         {
            "title": "Rule",
            "type": "object",
            "description": "Shows an existing rule.",
            "properties": {
               "type": {
                  "type": "string",
                  "enum": ["rule"]
               },
               "_ref": {
                  "type": "object",
                  "description": "The rule to show.",
                  "properties": {
                     "name": {
                        "type": "string",
                        "description": "Rule name."
                     },
                     "source": {
                        "type": "string",
                        "description": "Source abbreviation (example: CRB). Defaults to this content pack.",
                        "x-hb": { "span": 1 }
                     }
                  },
                  "required": [
                     "name"
                  ],
                  "optional": [
                     "source"
                  ],
                  "additionalProperties": false
               },
               "description": {
                  "type": "array",
                  "description": "Leave empty. The rule's own text is shown.",
                  "x-hb": { "widget": "paragraphs" },
                  "items": {
                     "type": "string"
                  }
               }
            },
            "required": [
               "type",
               "_ref",
               "description"
            ],
            "additionalProperties": false
         }
      ]
   }
}