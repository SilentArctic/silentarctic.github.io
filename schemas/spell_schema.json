{
   "$id": "https://silentarctic.github.io/schemas/spell_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Spell name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "imageUrl": {
            "title": "Image URL",
            "type": "string",
            "description": "URL of a related image.",
            "x-hb": { "span": "full" }
         },
         "concentration": {
            "type": "boolean",
            "description": "Whether the concentrate maneuver can sustain the spell."
         },
         "difficulty": {
            "type": "string",
            "description": "Base difficulty.",
            "enum": [
               "simple",
               "easy",
               "average",
               "hard",
               "daunting",
               "formidable"
            ]
         },
         "range": {
            "type": "string",
            "description": "Base range.",
            "enum": [
               "Self",
               "Engaged",
               "Short",
               "Medium",
               "Long",
               "Extreme",
               "Strategic"
            ]
         },
         "skills": {
            "type": "array",
            "description": "Skills that can cast this spell.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Skill name."
                  },
                  "source": {
                     "type": "string",
                     "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                     "x-hb": { "span": 1 }
                  }
               },
               "required": [
                  "name"
               ],
               "optional": [
                  "source"
               ],
               "additionalProperties": false
            }
         },
         "narrative": {
            "type": "array",
            "x-hb": { "widget": "paragraphs" },
            "description": "Narrative description.",
            "items": {
               "type": "string",
               "description": "Narrative description."
            }
         },
         "structured": {
            "type": "array",
            "x-hb": { "widget": "paragraphs" },
            "description": "Rules description.",
            "items": {
               "type": "string",
               "description": "Rules description."
            }
         },
         "additionalEffects": {
            "type": "array",
            "description": "Optional effects that raise the difficulty when added.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Effect name."
                  },
                  "difficultyMod": {
                     "title": "Difficulty modifier",
                     "type": "integer",
                     "description": "Difficulty dice added."
                  },
                  "difficultyUpgrade": {
                     "type": "integer",
                     "description": "Difficulty dice upgraded."
                  },
                  "description": {
                     "type": "array",
                     "x-hb": { "widget": "paragraphs" },
                     "description": "Effect text.",
                     "items": {
                        "type": "string",
                        "description": "Effect text."
                     }
                  }
               },
               "required": [
                  "name",
                  "description",
                  "difficultyMod"
               ],
               "optional": [
                  "difficultyUpgrade"
               ],
               "additionalProperties": false
            }
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "concentration",
         "difficulty",
         "skills",
         "narrative",
         "structured",
         "additionalEffects"
      ],
      "optional": [
         "page",
         "range",
         "imageUrl"
      ],
      "additionalProperties": false
   }
}