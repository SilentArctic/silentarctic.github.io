{
   "$id": "https://silentarctic.github.io/schemas/optionFeature_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Name of the option or feature."
         },
         "type": {
            "type": "string",
            "description": "Primary type. Add new types to _meta.filters.optionFeatureType.",
            "x-hb": { "span": 1 }
         },
         "class": {
            "type": "string",
            "description": "Secondary type. Add new classes to _meta.filters.optionFeatureClass.",
            "x-hb": { "span": 1 }
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "labels": {
            "type": "array",
            "description": "Labels shown above the description on every tab.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Label name, shown in bold."
                  },
                  "description": {
                     "type": ["string", "integer"],
                     "description": "Label value."
                  }
               },
               "required": [
                  "name",
                  "description"
               ],
               "additionalProperties": false
            }
         },
         "description": {
            "$ref": "varyingDisplay_sub_schema.json",
            "description": "Description of the option/feature."
         },
         "info": {
            "$ref": "varyingDisplay_sub_schema.json",
            "description": "Extra details, shown on a second tab."
         },
         "summary": {
            "type": "array",
            "description": "Deprecated. Leave empty.",
            "items": {
               "type": "string"
            },
            "x-hb": { "hidden": true }
         },
         "meta": {
            "type": "object",
            "description": "Internal metadata. Leave empty.",
            "x-hb": { "hidden": true }
         },
         "settings": {
            "$ref": "settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "type",
         "description"
      ],
      "optional": [
         "page",
         "labels",
         "info",
         "summary",
         "class",
         "meta",
         "settings"
      ],
      "additionalProperties": false
   }
}