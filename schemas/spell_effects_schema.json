{
   "$id": "https://silentarctic.github.io/schemas/spell_effects_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "spell": {
            "type": "string",
            "description": "Spell to change (example: Attack).",
            "x-hb": { "span": "full" }
         },
         "add": {
            "type": "array",
            "description": "Effects to add.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Effect name."
                  },
                  "description": {
                     "type": "array",
                     "x-hb": { "widget": "paragraphs" },
                     "description": "Effect text. Shown in its own subtable, apart from the base effects.",
                     "items": {
                        "type": "string"
                     }
                  },
                  "difficultyMod": {
                     "title": "Difficulty modifier",
                     "type": "integer",
                     "description": "Difficulty dice added."
                  }
               },
               "required": [
                  "name",
                  "description",
                  "difficultyMod"
               ]
            }
         },
         "remove": {
            "type": "array",
            "description": "Effects to remove. They stay in the table, marked as unavailable.",
            "items": {
               "type": "string",
               "description": "Effect name."
            }
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "spell"
      ],
      "optional": [
         "add",
         "remove"
      ],
      "additionalProperties": false
   }
}