{
   "$id": "https://silentarctic.github.io/schemas/adversary_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Adversary name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "type": {
            "type": "string",
            "enum": [
               "minion",
               "rival",
               "nemesis"
            ],
            "description": "Adversary tier. Minions have no skill ranks. Only nemeses track strain."
         },
         "npc": {
            "type": "boolean",
            "description": "Whether this adversary is a named NPC."
         },
         "hasVariants": {
            "type": "boolean",
            "description": "Whether variants of this adversary exist. Each variant is its own entry."
         },
         "variant": {
            "type": "boolean",
            "description": "Whether this is a variant of another adversary."
         },
         "characteristics": {
            "type": "object",
            "properties": {
               "brawn": {
                  "type": "integer"
               },
               "agility": {
                  "type": "integer"
               },
               "intellect": {
                  "type": "integer"
               },
               "cunning": {
                  "type": "integer"
               },
               "willpower": {
                  "type": "integer"
               },
               "presence": {
                  "type": "integer"
               }
            },
            "required": [
               "brawn",
               "agility",
               "intellect",
               "cunning",
               "willpower",
               "presence"
            ],
            "additionalProperties": false,
            "x-hb": { "columns": 3 }
         },
         "derived": {
            "type": "object",
            "description": "Attributes derived from characteristics and other features.",
            "properties": {
               "soak": {
                  "type": "integer"
               },
               "wounds": {
                  "type": "integer",
                  "title": "Wound Threshold"
               },
               "strain": {
                  "type": "integer",
                  "description": "Nemeses only.",
                  "title": "Strain Threshold"
               },
               "defense": {
                  "type": "array",
                  "description": "Melee, then ranged (example: [1, 0]).",
                  "items": {
                     "type": "integer"
                  },
                  "maxItems": 2
               }
            },
            "required": [
               "soak",
               "wounds",
               "defense"
            ],
            "optional": [
               "strain"
            ],
            "additionalProperties": false,
            "x-hb": { "columns": 3 }
         },
         "powerLevels": {
            "type": "object",
            "description": "Power estimates (Expanded Player's Guide p. 84).",
            "properties": {
               "combat": {
                  "type": "integer",
                  "description": "Combat power level."
               },
               "social": {
                  "type": "integer",
                  "description": "Social power level."
               },
               "general": {
                  "type": "integer",
                  "description": "General power level."
               }
            },
            "required": [
               "combat",
               "general",
               "social"
            ],
            "additionalProperties": false
         },
         "skills": {
            "type": "array",
            "description": "Skills the adversary has.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Skill name."
                  },
                  "characteristic": {
                     "type": "string",
                     "description": "Characteristic the skill uses.",
                     "enum": [
                        "brawn",
                        "agility",
                        "intellect",
                        "cunning",
                        "willpower",
                        "presence"
                     ]
                  },
                  "ranks": {
                     "type": "integer",
                     "description": "Skill ranks. Omit for minions."
                  },
                  "source": {
                     "type": "string",
                     "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                     "x-hb": { "span": 1 }
                  }
               },
               "required": [
                  "name",
                  "characteristic"
               ],
               "optional": [
                  "ranks",
                  "source"
               ],
               "additionalProperties": false
            }
         },
         "motivations": {
            "type": "array",
            "description": "Desires, fears, strengths, and flaws.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Motivation name."
                  },
                  "description": {
                     "type": "string",
                     "description": "Motivation details.",
                     "x-hb": { "span": "full" }
                  }
               },
               "required": [
                  "name",
                  "description"
               ],
               "additionalProperties": false
            }
         },
         "talents": {
            "type": "array",
            "description": "Talents the adversary has.",
            "items": {
               "oneOf": [
                  {
                     "title": "Internal Talent",
                     "type": "string",
                     "description": "Name of a talent in this content pack."
                  },
                  {
                     "title": "External Talent",
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Talent name."
                        },
                        "source": {
                           "type": "string",
                           "description": "Source abbreviation (example: CRB).",
                           "x-hb": { "span": 1 }
                        }
                     },
                     "required": [
                        "name",
                        "source"
                     ],
                     "additionalProperties": false
                  }
               ]
            }
         },
         "abilities": {
            "type": "array",
            "description": "Adversary abilities.",
            "items": {
               "oneOf": [
                  {
                     "title": "External Ability",
                     "type": "string",
                     "description": "Name of an adversary ability from any installed content pack."
                  },

                  {
                     "title": "Private Ability",
                     "type": "object",
                     "description": "An ability written only for this adversary.",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Ability name."
                        },
                        "description": {
                           "type": "string",
                           "description": "Ability text.",
                           "x-hb": { "span": "full" }
                        }
                     },
                     "required": [
                        "name",
                        "description"
                     ],
                     "additionalProperties": false
                  }
               ]
            }
         },
         "spells": {
            "type": "object",
            "description": "Magic skills and prepared spells, for spellcasters.",
            "properties": {
               "skills": {
                  "type": "array",
                  "description": "Magic skills the adversary casts with.",
                  "items": {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Skill name."
                        },
                        "source": {
                           "type": "string",
                           "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                           "x-hb": { "span": 1 }
                        }
                     },
                     "required": [
                        "name"
                     ],
                     "optional": [
                        "source"
                     ],
                     "additionalProperties": false
                  }
               },
               "spells": {
                  "type": "array",
                  "description": "Prepared spells, written out in full.",
                  "items": {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Spell name. Can include the difficulty with a difficulty tag."
                        },
                        "description": {
                           "type": "string",
                           "description": "Spell effects.",
                           "x-hb": { "span": "full" }
                        }
                     },
                     "required": [
                        "name",
                        "description"
                     ],
                     "additionalProperties": false
                  }
               }
            },
            "required": [
               "skills",
               "spells"
            ],
            "additionalProperties": false
         },
         "weapons": {
            "type": "array",
            "description": "Weapons the adversary attacks with.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Weapon name."
                  },
                  "skill": {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Skill used to attack."
                        },
                        "source": {
                           "type": "string",
                           "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                           "x-hb": { "span": 1 }
                        }
                     },
                     "required": [
                        "name"
                     ],
                     "optional": [
                        "source"
                     ],
                     "additionalProperties": false
                  },
                  "damage": {
                     "type": "integer",
                     "description": "Total damage, Brawn included."
                  },
                  "critical": {
                     "type": "integer",
                     "description": "Critical rating: Advantage needed to trigger a critical hit."
                  },
                  "range": {
                     "type": "string",
                     "enum": [
                        "Engaged",
                        "Short",
                        "Medium",
                        "Long",
                        "Extreme",
                        "Strategic"
                     ],
                     "description": "Maximum range."
                  },
                  "qualities": {
                     "type": "array",
                     "description": "Weapon qualities.",
                     "items": {
                        "type": "object",
                        "properties": {
                           "name": {
                              "type": "string",
                              "description": "Quality name."
                           },
                           "ranks": {
                              "type": "integer",
                              "description": "Quality ranks."
                           },
                           "source": {
                              "type": "string",
                              "description": "Source of the quality (abbreviation) if not found in this content pack (example: CRB).",
                              "x-hb": { "span": 1 }
                           }
                        },
                        "required": [
                           "name"
                        ],
                        "optional": [
                           "ranks",
                           "source"
                        ],
                        "additionalProperties": false
                     }
                  },
                  "details": {
                     "type": "string",
                     "description": "Extra notes shown with the weapon.",
                     "x-hb": { "span": "full" }
                  }
               },
               "required": [
                  "name",
                  "skill",
                  "damage",
                  "critical",
                  "range"
               ],
               "optional": [
                  "qualities",
                  "details"
               ],
               "additionalProperties": false
            }
         },
         "gear": {
            "type": "array",
            "description": "Other gear the adversary carries.",
            "items": {
               "type": "string",
               "description": "Gear entry. Text before \": \" is bolded; without one, the whole entry is."
            }
         },
         "description": {
            "$ref": "./varyingDisplay_sub_schema.json",
            "description": "Adversary description."
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "tags": {
            "type": "array",
            "description": "Deprecated. Use powerLevels instead.",
            "x-hb": { "hidden": true },
            "items": {
               "type": "string"
            }
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "type",
         "characteristics",
         "derived",
         "skills"
      ],
      "optional": [
         "page",
         "npc",
         "variant",
         "hasVariants",
         "description",
         "powerLevels",
         "motivations",
         "talents",
         "abilities",
         "weapons",
         "gear",
         "tags",
         "settings"
      ],
      "additionalProperties": false
   }
}