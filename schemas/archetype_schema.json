{
   "$id": "https://silentarctic.github.io/schemas/archetype_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Archetype or Species name."
         },
         "nickname": {
            "type": "string",
            "description": "Optional nickname (ideal for keeping similar archetypes together ie. Dwarf (Dunwarr) and Dwarf (Forge)."
         },
         "characteristics": {
            "oneOf": [
               {
                  "type": "object",
                  "title": "Standard",
                  "properties": {
                     "brawn": {
                        "type": "integer",
                        "description": "Starting Brawn."
                     },
                     "agility": {
                        "type": "integer",
                        "description": "Starting Agility."
                     },
                     "intellect": {
                        "type": "integer",
                        "description": "Starting Intellect."
                     },
                     "cunning": {
                        "type": "integer",
                        "description": "Starting Cunning."
                     },
                     "willpower": {
                        "type": "integer",
                        "description": "Starting Willpower."
                     },
                     "presence": {
                        "type": "integer",
                        "description": "Starting Presence."
                     }
                  },
                  "required": [
                     "brawn",
                     "agility",
                     "intellect",
                     "cunning",
                     "willpower",
                     "presence"
                  ],
                  "additionalProperties": false
               },
               {
                  "type": "array",
                  "title": "Archetype Pair",
                  "items": {
                     "type": "object",
                     "properties": {
                        "brawn": {
                           "type": "integer",
                           "description": "Starting Brawn."
                        },
                        "agility": {
                           "type": "integer",
                           "description": "Starting Agility."
                        },
                        "intellect": {
                           "type": "integer",
                           "description": "Starting Intellect."
                        },
                        "cunning": {
                           "type": "integer",
                           "description": "Starting Cunning."
                        },
                        "willpower": {
                           "type": "integer",
                           "description": "Starting Willpower."
                        },
                        "presence": {
                           "type": "integer",
                           "description": "Starting Presence."
                        }
                     },
                     "required": [
                        "brawn",
                        "agility",
                        "intellect",
                        "cunning",
                        "willpower",
                        "presence"
                     ],
                     "additionalProperties": false
                  }
               }
            ]
         },
         "page": {
            "type": "integer",
            "description": "Source page reference."
         },
         "imageUrl": {
            "type": "string",
            "description": "Url for a related image."
         },
         "wt": {
            "description": "Wound threshold.",
            "oneOf": [
               {
                  "type": "integer",
                  "title": "Standard"
               },
               {
                  "type": "array",
                  "title": "Archetype Pair",
                  "items": {
                     "type": "integer"
                  }
               }
            ]
         },
         "st": {
            "description": "Strain threshold.",
            "oneOf": [
               {
                  "type": "integer",
                  "title": "Standard"
               },
               {
                  "type": "array",
                  "title": "Archetype Pair",
                  "items": {
                     "type": "integer"
                  }
               }
            ]
         },
         "xp": {
            "type": "integer",
            "description": "Starting XP."
         },
         "skills": {
            "type": "object",
            "description": "Starting skill ranks.",
            "properties": {
               "skills": {
                  "type": "array",
                  "description": "Starting skill options.",
                  "items": {
                     "oneOf": [
                        {
                           "type": "string"
                        },

                        {
                           "type": "object",
                           "properties": {
                              "name": {
                                 "type": "string",
                                 "description": "Skill name."
                              },
                              "source": {
                                 "type": "string",
                                 "description": "Skill source."
                              },
                              "ranks": {
                                 "type": "number",
                                 "description": "Skill ranks (default 1).",
                                 "default": 1
                              }
                           },
                           "required": [
                              "name"
                           ],
                           "optional": [
                              "source",
                              "ranks"
                           ],
                           "additionalProperties": false
                        }
                     ]
                  }
               },
               "ranksTotal": {
                  "type": "integer",
                  "description": "Meta field. # of total ranks this archetype starts with."
               },
               "ranksEach": {
                  "type": "integer",
                  "description": "Meta field. # of ranks each skill receives."
               },
               "description": {
                  "type": "array",
                  "description": "Text displayed on the archetype. This is *not* derived from the other fields here due to the vast variety of possibilities.",
                  "items": {
                     "type": "string"
                  }
               },
               "choice": {
                  "oneOf": [
                     {
                        "type": "boolean",
                        "description": "If the player has a choice between skills to put starting ranks into."
                     },

                     {
                        "type": "array",
                        "items": {
                           "oneOf": [
                              {
                                 "type": "string",
                                 "enum": [
                                    "any",
                                    "career",
                                    "non-career",
                                    "general",
                                    "combat",
                                    "social",
                                    "knowledge",
                                    "magic",
                                    "brawn",
                                    "agility",
                                    "intellect",
                                    "cunning",
                                    "willpower",
                                    "presence"
                                 ],
                                 "description": "Can choose any skill within the given category."
                              },

                              {
                                 "type": "object",
                                 "properties": {
                                    "name": {
                                       "type": "string",
                                       "description": "Skill name."
                                    },
                                    "source": {
                                       "type": "string",
                                       "description": "Skill source."
                                    },
                                    "ranks": {
                                       "type": "number",
                                       "description": "Skill ranks (default 1).",
                                       "default": 1
                                    }
                                 },
                                 "required": [
                                    "name"
                                 ],
                                 "optional": [
                                    "source",
                                    "ranks"
                                 ],
                                 "additionalProperties": false
                              }
                           ]
                        }
                     }
                  ]
               }
            },
            "required": [
               "skills",
               "ranksTotal",
               "ranksEach",
               "description",
               "choice"
            ],
            "additionalProperties": false
         },
         "abilities": {
            "type": "array",
            "description": "List of unique archetype abilities",
            "items": {
               "oneOf": [
                  {
                     "type": "string",
                     "title": "External ability",
                     "description": "Name of archetype ability from any source."
                  },
                  {
                     "type": "object",
                     "title": "Private ability",
                     "description": "Custom ability only for this archetype.",
                     "properties": {
                        "description": {
                           "type": "array",
                           "items": {
                              "type": "string"
                           }
                        }
                     }
                  }
               ]
            }
         },
         "description": {
            "type": "array",
            "description": "Adversary description.",
            "items": {
               "type": "string"
            }
         },
         "why": {
            "type": "array",
            "description": "Reasons why one would choose to play as this archetype.",
            "items": {
               "type": "string"
            }
         },
         "names": {
            "type": "object",
            "description": "Suggested names for this archetype.",
            "properties": {
               "description": {
                  "type": "array",
                  "description": "Brief description about this archetype's naming conventions.",
                  "items": {
                     "type": "string"
                  }
               },
               "names": {
                  "type": "array",
                  "description": "List of suggested names.",
                  "items": {
                     "type": "string"
                  }
               }
            }
         },
         "modifiers": {
            "type": "object"
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Override global content pack settings for this item."
         },
         "id": {
            "type": "string",
            "description": "Unique item id. You shouldn't have to touch this field."
         }
      },
      "required": [
         "name",
         "wt",
         "st",
         "xp",
         "skills",
         "abilities",
         "description"
      ],
      "optional": [
         "page",
         "nickname",
         "imageUrl",
         "why",
         "names",
         "modifiers",
         "settings"
      ],
      "additionalProperties": false
   }
}