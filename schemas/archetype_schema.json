{
   "$id": "https://silentarctic.github.io/schemas/archetype_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Archetype or Species name."
         },
         "nickname": {
            "type": "string",
            "description": "Groups similar archetypes (example: Dwarf (Dunwarr) and Dwarf (Forge))."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "xp": {
            "type": "integer",
            "description": "Starting XP.",
            "title": "XP"
         },
         "imageUrl": {
            "title": "Image URL",
            "type": "string",
            "description": "URL of a related image.",
            "x-hb": { "span": "full" }
         },
         "characteristics": {
            "oneOf": [
               {
                  "type": "object",
                  "title": "Standard",
                  "properties": {
                     "brawn": {
                        "type": "integer",
                        "description": "Starting Brawn."
                     },
                     "agility": {
                        "type": "integer",
                        "description": "Starting Agility."
                     },
                     "intellect": {
                        "type": "integer",
                        "description": "Starting Intellect."
                     },
                     "cunning": {
                        "type": "integer",
                        "description": "Starting Cunning."
                     },
                     "willpower": {
                        "type": "integer",
                        "description": "Starting Willpower."
                     },
                     "presence": {
                        "type": "integer",
                        "description": "Starting Presence."
                     }
                  },
                  "required": [
                     "brawn",
                     "agility",
                     "intellect",
                     "cunning",
                     "willpower",
                     "presence"
                  ],
                  "additionalProperties": false,
                  "x-hb": { "columns": 3 }
               },
               {
                  "type": "array",
                  "title": "Archetype Pair",
                  "items": {
                     "type": "object",
                     "properties": {
                        "brawn": {
                           "type": "integer",
                           "description": "Starting Brawn."
                        },
                        "agility": {
                           "type": "integer",
                           "description": "Starting Agility."
                        },
                        "intellect": {
                           "type": "integer",
                           "description": "Starting Intellect."
                        },
                        "cunning": {
                           "type": "integer",
                           "description": "Starting Cunning."
                        },
                        "willpower": {
                           "type": "integer",
                           "description": "Starting Willpower."
                        },
                        "presence": {
                           "type": "integer",
                           "description": "Starting Presence."
                        }
                     },
                     "required": [
                        "brawn",
                        "agility",
                        "intellect",
                        "cunning",
                        "willpower",
                        "presence"
                     ],
                     "additionalProperties": false,
                     "x-hb": { "columns": 3 }
                  }
               }
            ]
         },
         "wt": {
            "title": "Wound threshold",
            "description": "Base wound threshold. Brawn is added on top.",
            "oneOf": [
               {
                  "type": "integer",
                  "title": "Standard"
               },
               {
                  "type": "array",
                  "title": "Archetype Pair",
                  "items": {
                     "type": "integer"
                  }
               }
            ]
         },
         "st": {
            "title": "Strain threshold",
            "description": "Base strain threshold. Willpower is added on top.",
            "oneOf": [
               {
                  "type": "integer",
                  "title": "Standard"
               },
               {
                  "type": "array",
                  "title": "Archetype Pair",
                  "items": {
                     "type": "integer"
                  }
               }
            ]
         },
         "skills": {
            "type": "object",
            "description": "Starting skill ranks.",
            "properties": {
               "skills": {
                  "type": "array",
                  "description": "Skills the archetype grants ranks in.",
                  "items": {
                     "oneOf": [
                        {
                           "type": "string",
                           "title": "Skill",
                           "description": "Skill name."
                        },

                        {
                           "type": "object",
                           "title": "Skill with details",
                           "properties": {
                              "name": {
                                 "type": "string",
                                 "description": "Skill name."
                              },
                              "source": {
                                 "type": "string",
                                 "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                                 "x-hb": { "span": 1 }
                              },
                              "ranks": {
                                 "type": "number",
                                 "description": "Ranks granted. Defaults to 1.",
                                 "default": 1
                              }
                           },
                           "required": [
                              "name"
                           ],
                           "optional": [
                              "source",
                              "ranks"
                           ],
                           "additionalProperties": false
                        }
                     ]
                  }
               },
               "ranksTotal": {
                  "title": "Total ranks",
                  "type": "integer",
                  "description": "Total free ranks the player assigns. Used by the character sheet."
               },
               "ranksEach": {
                  "type": "integer",
                  "description": "Ranks per picked skill. Skills picked = ranksTotal / ranksEach."
               },
               "description": {
                  "type": "array",
                  "x-hb": { "widget": "paragraphs" },
                  "description": "Skill text shown on the archetype. Not generated from the other fields.",
                  "items": {
                     "type": "string"
                  }
               },
               "choice": {
                  "oneOf": [
                     {
                        "type": "boolean",
                        "title": "Any choice",
                        "description": "Whether the player picks the skills."
                     },

                     {
                        "type": "array",
                        "title": "Limited choice",
                        "description": "Skills or skill categories the player can choose from.",
                        "items": {
                           "oneOf": [
                              {
                                 "type": "string",
                                 "title": "Category",
                                 "enum": [
                                    "any",
                                    "career",
                                    "non-career",
                                    "general",
                                    "combat",
                                    "social",
                                    "knowledge",
                                    "magic",
                                    "brawn",
                                    "agility",
                                    "intellect",
                                    "cunning",
                                    "willpower",
                                    "presence"
                                 ],
                                 "description": "Any skill in this category."
                              },

                              {
                                 "type": "object",
                                 "title": "Skill",
                                 "properties": {
                                    "name": {
                                       "type": "string",
                                       "description": "Skill name."
                                    },
                                    "source": {
                                       "type": "string",
                                       "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                                       "x-hb": { "span": 1 }
                                    },
                                    "ranks": {
                                       "type": "number",
                                       "description": "Ranks granted. Defaults to 1.",
                                       "default": 1
                                    }
                                 },
                                 "required": [
                                    "name"
                                 ],
                                 "optional": [
                                    "source",
                                    "ranks"
                                 ],
                                 "additionalProperties": false
                              }
                           ]
                        }
                     }
                  ]
               }
            },
            "required": [
               "skills",
               "ranksTotal",
               "ranksEach",
               "description",
               "choice"
            ],
            "additionalProperties": false
         },
         "abilities": {
            "type": "array",
            "description": "Archetype abilities.",
            "items": {
               "oneOf": [
                  {
                     "type": "string",
                     "title": "External ability",
                     "description": "Name of an archetype ability from any installed content pack."
                  },
                  {
                     "type": "object",
                     "title": "Private ability",
                     "description": "An ability written only for this archetype.",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Ability name."
                        },
                        "description": {
                           "type": "string",
                           "description": "Ability text.",
                           "x-hb": { "span": "full" }
                        }
                     },
                     "required": [
                        "description"
                     ],
                     "optional": [
                        "name"
                     ],
                     "additionalProperties": false
                  }
               ]
            }
         },
         "description": {
            "type": "array",
            "x-hb": { "widget": "paragraphs" },
            "description": "Archetype description.",
            "items": {
               "type": "string"
            }
         },
         "why": {
            "title": "Reasons to play",
            "type": "array",
            "description": "Reasons to pick this archetype.",
            "items": {
               "type": "string"
            }
         },
         "names": {
            "type": "object",
            "description": "Suggested names for this archetype.",
            "properties": {
               "description": {
                  "type": "array",
                  "x-hb": { "widget": "paragraphs" },
                  "description": "Naming conventions.",
                  "items": {
                     "type": "string"
                  }
               },
               "names": {
                  "type": "array",
                  "description": "Example names.",
                  "items": {
                     "type": "string"
                  }
               }
            }
         },
         "modifiers": {
            "type": "object",
            "description": "Effects applied to characters with this archetype on the character sheet.",
            "x-hb": { "hidden": true },
            "properties": {
               "stats": {
                  "type": "object",
                  "description": "Bonuses added to derived stats.",
                  "properties": {
                     "soak": {
                        "type": "integer"
                     },
                     "mDefense": {
                        "title": "Melee defense",
                        "type": "integer",
                        "description": "Melee defense."
                     },
                     "rDefense": {
                        "title": "Ranged defense",
                        "type": "integer",
                        "description": "Ranged defense."
                     },
                     "wt": {
                        "title": "Wound threshold",
                        "type": "integer",
                        "description": "Wound threshold."
                     },
                     "st": {
                        "title": "Strain threshold",
                        "type": "integer",
                        "description": "Strain threshold."
                     },
                     "et": {
                        "title": "Encumbrance threshold",
                        "type": "integer",
                        "description": "Encumbrance threshold."
                     }
                  },
                  "additionalProperties": false
               },
               "skills": {
                  "type": "array",
                  "description": "Skill ranks granted by the archetype.",
                  "items": {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Skill name."
                        },
                        "source": {
                           "type": "string",
                           "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                           "x-hb": { "span": 1 }
                        },
                        "career": {
                           "type": "boolean",
                           "description": "Whether the skill becomes a career skill."
                        },
                        "ranks": {
                           "type": "integer",
                           "description": "Skill ranks granted."
                        }
                     },
                     "required": [
                        "name"
                     ],
                     "optional": [
                        "source",
                        "career",
                        "ranks"
                     ],
                     "additionalProperties": false
                  }
               },
               "roll": {
                  "type": "array",
                  "description": "Modifiers applied to matching checks. With no skills or skillTypes, applies to every check.",
                  "items": {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Modifier name."
                        },
                        "description": {
                           "type": "string",
                           "description": "Text shown with the roll.",
                           "x-hb": { "span": "full" }
                        },
                        "skills": {
                           "type": "array",
                           "description": "Skill names this modifier applies to.",
                           "items": {
                              "type": "string"
                           }
                        },
                        "skillTypes": {
                           "type": "array",
                           "description": "Skill categories this modifier applies to.",
                           "items": {
                              "type": "string"
                           }
                        },
                        "damage": {
                           "type": "integer",
                           "description": "Damage added to attacks."
                        },
                        "qualities": {
                           "type": "array",
                           "description": "Item qualities added to attacks.",
                           "items": {
                              "type": "object",
                              "properties": {
                                 "name": {
                                    "type": "string",
                                    "description": "Quality name."
                                 },
                                 "value": {
                                    "type": "integer",
                                    "description": "Quality ranks."
                                 },
                                 "source": {
                                    "type": "string",
                                    "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                                    "x-hb": { "span": 1 }
                                 }
                              },
                              "required": [
                                 "name"
                              ],
                              "optional": [
                                 "value",
                                 "source"
                              ],
                              "additionalProperties": false
                           }
                        }
                     },
                     "required": [
                        "name",
                        "description"
                     ],
                     "optional": [
                        "skills",
                        "skillTypes",
                        "damage",
                        "qualities"
                     ],
                     "additionalProperties": false
                  }
               },
               "equipment": {
                  "type": "object",
                  "description": "Gear the character starts with, grouped by equipment type.",
                  "propertyNames": {
                     "enum": [
                        "weapon",
                        "armor",
                        "gear"
                     ]
                  },
                  "additionalProperties": {
                     "type": "array",
                     "items": { "$ref": "./gear_schema.json#/items" }
                  }
               }
            },
            "optional": [
               "stats",
               "skills",
               "roll",
               "equipment"
            ],
            "additionalProperties": false
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "wt",
         "st",
         "xp",
         "skills",
         "abilities",
         "description"
      ],
      "optional": [
         "page",
         "nickname",
         "imageUrl",
         "why",
         "names",
         "modifiers",
         "settings"
      ],
      "additionalProperties": false
   }
}