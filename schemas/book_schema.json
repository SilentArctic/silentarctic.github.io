{
   "$id": "https://silentarctic.github.io/schemas/book_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Book title."
         },
         "subtitle": {
            "type": "string",
            "description": "Book subtitle."
         },
         "releaseYear": {
            "type": "integer",
            "description": "Release year."
         },
         "coverImageUrl": {
            "type": "string",
            "description": "URL of the cover image.",
            "x-hb": { "span": "full" }
         },
         "coverBackgroundUrl": {
            "type": "string",
            "description": "Deprecated. Leave empty.",
            "x-hb": { "span": "full" }
         },
         "backgroundUrl": {
            "type": "string",
            "description": "URL of a background image for every page.",
            "x-hb": { "span": "full" }
         },
         "credits": {
            "type": "object",
            "description": "Credits by role. Each key is a role (example: Writing), each value the names.",
            "patternProperties": {
               "^[a-zA-Z ]*$": {
                  "type": "array",
                  "items": {
                     "type": "string"
                  }
               }
            }
         },
         "chapters": {
            "$ref": "varyingDisplay_sub_schema.json",
            "description": "Book text. Usually one titled block per chapter."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "chapters"
      ],
      "optional": [
         "subtitle",
         "releaseYear",
         "coverImageUrl",
         "coverBackgroundUrl",
         "backgroundUrl",
         "credits"
      ],
      "additionalProperties": false
   }
}