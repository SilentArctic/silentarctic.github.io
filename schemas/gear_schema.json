{
   "$id": "https://silentarctic.github.io/schemas/gear_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Gear name."
         },
         "type": {
            "type": "string",
            "enum": [
               "alchemy",
               "armor",
               "artifact",
               "attachment",
               "cybernetic",
               "g-mod",
               "gear",
               "implement",
               "magic",
               "mount",
               "treasure",
               "weapon"
            ],
            "description": "Gear type. Each type adds its own fields."
         },
         "class": {
            "type": "string",
            "description": "Subcategory (example: Energy, Military).",
            "x-hb": { "span": 1 }
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "imageUrl": {
            "title": "Image URL",
            "type": "string",
            "description": "URL of an image of the gear.",
            "x-hb": { "span": "full" }
         },
         "description": {
            "$ref": "./varyingDisplay_sub_schema.json",
            "description": "Gear description."
         },
         "price": {
            "description": "Price.",
            "oneOf": [
               {
                  "type": "integer",
                  "title": "value",
                  "description": "Price."
               },
               {
                  "type": "string",
                  "title": "default option",
                  "description": "For items that have no price.",
                  "enum": [
                     "priceless",
                     "n/a",
                     "if you have to ask..."
                  ]
               }
            ]
         },
         "rarity": {
            "type": [
               "integer",
               "null"
            ],
            "description": "Rarity, 0 to 10."
         },
         "restricted": {
            "type": "boolean",
            "description": "Whether the gear is restricted (R)."
         },
         "modifiers": {
            "type": "array",
            "description": "Stat changes the item grants. Only used by the Emporium export.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "What it changes (example: Brawn, Strain Threshold, encumbrance)."
                  },
                  "type": {
                     "type": "string",
                     "description": "A characteristic, skill, derived stat (thresholds, soak, defense), or own stat (this item's stats).",
                     "enum": [
                        "characteristic",
                        "skill",
                        "derived",
                        "own stat"
                     ]
                  },
                  "value": {
                     "description": "Signed change (example: +1). Skills also accept dice and symbol tags.",
                     "type": [
                        "string",
                        "integer"
                     ]
                  }
               },
               "required": [
                  "name",
                  "value"
               ],
               "optional": [
                  "type"
               ],
               "additionalProperties": false
            }
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "type",
         "description",
         "price",
         "rarity"
      ],
      "optional": [
         "imageUrl",
         "page",
         "class",
         "modifiers",
         "settings"
      ],
      "propertyNames": {
         "enum": [
            "name",
            "type",
            "class",
            "page",
            "imageUrl",
            "description",
            "price",
            "rarity",
            "restricted",
            "modifiers",
            "settings",
            "id",
            "skill",
            "damage",
            "critical",
            "range",
            "encumbrance",
            "hardPoints",
            "special",
            "defense",
            "soak",
            "qualities"
         ]
      },
      "allOf": [
         {
            "if": {
               "required": [
                  "type"
               ],
               "properties": {
                  "type": {
                     "const": "weapon"
                  }
               }
            },
            "then": {
               "properties": {
                  "skill": {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Skill used to attack."
                        },
                        "source": {
                           "type": "string",
                           "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                           "x-hb": { "span": 1 }
                        }
                     },
                     "required": [
                        "name"
                     ],
                     "optional": [
                        "source"
                     ],
                     "additionalProperties": false
                  },
                  "damage": {
                     "type": [
                        "string",
                        "integer"
                     ],
                     "description": "Base damage. Prefix \"+\" for melee weapons that add Brawn (example: +2).",
                     "x-hb": { "span": 1 }
                  },
                  "critical": {
                     "type": "integer",
                     "description": "Critical rating: Advantage needed to trigger a critical hit."
                  },
                  "range": {
                     "type": "string",
                     "enum": [
                        "Engaged",
                        "Short",
                        "Medium",
                        "Long",
                        "Extreme",
                        "Strategic"
                     ],
                     "description": "Maximum range."
                  },
                  "encumbrance": {
                     "type": "integer",
                     "description": "Encumbrance of the weapon."
                  },
                  "hardPoints": {
                     "type": "integer",
                     "description": "Hard points available for attachments."
                  },
                  "special": {
                     "type": "array",
                     "description": "Weapon qualities.",
                     "items": {
                        "type": "object",
                        "properties": {
                           "name": {
                              "type": "string",
                              "description": "Quality name."
                           },
                           "value": {
                              "type": "integer",
                              "description": "Quality ranks. Omit for unranked qualities."
                           },
                           "source": {
                              "type": "string",
                              "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                              "x-hb": { "span": 1 }
                           }
                        },
                        "required": [
                           "name"
                        ],
                        "optional": [
                           "value",
                           "source"
                        ],
                        "additionalProperties": false
                     }
                  }
               },
               "required": [
                  "skill",
                  "damage",
                  "critical",
                  "range",
                  "encumbrance"
               ],
               "optional": [
                  "hardPoints",
                  "restricted",
                  "special"
               ]
            }
         },
         {
            "if": {
               "required": [
                  "type"
               ],
               "properties": {
                  "type": {
                     "const": "armor"
                  }
               }
            },
            "then": {
               "properties": {
                  "defense": {
                     "type": "integer",
                     "description": "Defense granted."
                  },
                  "soak": {
                     "type": "string",
                     "description": "Soak granted.",
                     "x-hb": { "span": 1 }
                  },
                  "encumbrance": {
                     "type": "integer",
                     "description": "Encumbrance of the armor."
                  },
                  "hardPoints": {
                     "type": "integer",
                     "description": "Hard points available for attachments."
                  },
                  "special": {
                     "type": "array",
                     "description": "Armor qualities.",
                     "items": {
                        "type": "object",
                        "properties": {
                           "name": {
                              "type": "string",
                              "description": "Quality name."
                           },
                           "value": {
                              "type": "integer",
                              "description": "Quality ranks. Omit for unranked qualities."
                           },
                           "source": {
                              "type": "string",
                              "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                              "x-hb": { "span": 1 }
                           }
                        },
                        "required": [
                           "name"
                        ],
                        "optional": [
                           "value",
                           "source"
                        ],
                        "additionalProperties": false
                     }
                  }
               },
               "required": [
                  "defense",
                  "soak",
                  "encumbrance"
               ],
               "optional": [
                  "hardPoints",
                  "special"
               ]
            }
         },
         {
            "if": {
               "required": [
                  "type"
               ],
               "properties": {
                  "type": {
                     "enum": [
                        "gear",
                        "treasure",
                        "alchemy",
                        "artifact",
                        "magic",
                        "mount"
                     ]
                  }
               }
            },
            "then": {
               "properties": {
                  "encumbrance": {
                     "type": [
                        "string",
                        "integer"
                     ],
                     "description": "Encumbrance. Use a negative value for items that raise capacity, like backpacks."
                  }
               },
               "optional": [
                  "encumbrance"
               ]
            }
         },
         {
            "if": {
               "required": [
                  "type"
               ],
               "properties": {
                  "type": {
                     "enum": [
                        "cybernetic",
                        "g-mod"
                     ]
                  }
               }
            },
            "then": {
               "properties": {},
               "required": [],
               "optional": []
            }
         },
         {
            "if": {
               "required": [
                  "type"
               ],
               "properties": {
                  "type": {
                     "const": "implement"
                  }
               }
            },
            "then": {
               "properties": {
                  "damage": {
                     "type": "string",
                     "description": "Damage added to the Attack spell.",
                     "x-hb": { "span": 1 }
                  },
                  "encumbrance": {
                     "type": "integer",
                     "description": "Encumbrance of the implement."
                  }
               },
               "required": [
                  "damage",
                  "encumbrance"
               ]
            }
         },
         {
            "if": {
               "required": [
                  "type"
               ],
               "properties": {
                  "type": {
                     "const": "attachment"
                  }
               }
            },
            "then": {
               "properties": {
                  "hardPoints": {
                     "type": "integer",
                     "description": "Hard points the attachment uses."
                  },
                  "qualities": {
                     "type": "array",
                     "description": "Qualities the attachment adds.",
                     "items": {
                        "type": "object",
                        "properties": {
                           "name": {
                              "type": "string",
                              "description": "Quality name."
                           },
                           "ranks": {
                              "type": [
                                 "string",
                                 "integer"
                              ],
                              "description": "Quality ranks. Omit for unranked qualities."
                           },
                           "source": {
                              "type": "string",
                              "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                              "x-hb": { "span": 1 }
                           }
                        },
                        "required": [
                           "name"
                        ],
                        "optional": [
                           "ranks",
                           "source"
                        ],
                        "additionalProperties": false
                     }
                  }
               },
               "required": [
                  "hardPoints"
               ],
               "optional": [
                  "qualities"
               ]
            }
         }
      ]
   }
}