{
   "$id": "https://silentarctic.github.io/schemas/vehicle_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Vehicle name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "tribe": {
            "type": "string",
            "description": "Faction or group, used to group vehicles."
         },
         "variant": {
            "type": "boolean",
            "description": "Whether this is a variant of another vehicle."
         },
         "hasVariants": {
            "type": "boolean",
            "description": "Whether variants of this vehicle exist. Each variant is its own entry."
         },
         "imageUrl": {
            "title": "Image URL",
            "type": "string",
            "description": "URL of an image of the vehicle.",
            "x-hb": { "span": "full" }
         },
         "silhouette": {
            "type": "integer",
            "description": "Silhouette (size)."
         },
         "maxSpeed": {
            "type": "integer",
            "description": "Max speed."
         },
         "handling": {
            "type": "integer",
            "description": "Handling. Negative for vehicles that are hard to steer."
         },
         "defense": {
            "type": "integer",
            "description": "Defense."
         },
         "armor": {
            "type": "integer",
            "description": "Armor (vehicle soak)."
         },
         "htt": {
            "title": "Hull trauma threshold",
            "type": "integer",
            "description": "Hull trauma threshold.",
            "x-hb": { "span": 2 }
         },
         "sst": {
            "title": "System strain threshold",
            "type": "integer",
            "description": "System strain threshold.",
            "x-hb": { "span": 2 }
         },
         "controlSkill": {
            "type": "object",
            "description": "Skill used to pilot or drive.",
            "properties": {
               "name": {
                  "type": "string",
                  "description": "Skill name."
               },
               "source": {
                  "type": "string",
                  "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                  "x-hb": { "span": 1 }
               }
            },
            "required": [
               "name"
            ],
            "optional": [
               "source"
            ],
            "additionalProperties": false
         },
         "complement": {
            "type": "string",
            "description": "Crew needed to operate it.",
            "x-hb": { "span": 1 }
         },
         "passengers": {
            "type": ["string", "integer"],
            "description": "Passenger capacity."
         },
         "consumables": {
            "type": "string",
            "description": "How long supplies last (example: 2 weeks).",
            "x-hb": { "span": 1 }
         },
         "encumbranceCapacity": {
            "type": ["string", "integer"],
            "description": "Cargo capacity, in encumbrance."
         },
         "ftlRange": {
            "title": "FTL range",
            "type": "string",
            "enum": [
               "None",
               "Short",
               "Medium",
               "Long",
               "Extreme"
            ],
            "description": "Faster-than-light range."
         },
         "ftlSpeed": {
            "title": "FTL speed",
            "type": "string",
            "enum": [
               "none",
               "slow",
               "average",
               "fast",
               "very fast"
            ],
            "description": "Faster-than-light speed."
         },
         "price": {
            "type": "integer",
            "description": "Price."
         },
         "rarity": {
            "type": "integer",
            "description": "Rarity, 0 to 10."
         },
         "restricted": {
            "type": "boolean",
            "description": "Whether the vehicle is restricted (R)."
         },
         "weapons": {
            "type": "array",
            "description": "Mounted weapons.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Weapon name.",
                     "x-hb": { "span": "full" }
                  },
                  "skill": {
                     "type": "object",
                     "properties": {
                        "name": {
                           "type": "string",
                           "description": "Skill used to attack."
                        },
                        "source": {
                           "type": "string",
                           "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                           "x-hb": { "span": 1 }
                        }
                     },
                     "required": [
                        "name"
                     ],
                     "optional": [
                        "source"
                     ],
                     "additionalProperties": false
                  },
                  "fireArc": {
                     "type": "string",
                     "description": "Firing arc (example: Forward).",
                     "x-hb": { "span": 1 }
                  },
                  "damage": {
                     "type": "integer",
                     "description": "Weapon damage."
                  },
                  "critical": {
                     "type": "integer",
                     "description": "Critical rating: Advantage needed to trigger a critical hit."
                  },
                  "range": {
                     "type": "string",
                     "enum": ["Engaged", "Short", "Medium", "Long", "Extreme", "Strategic"],
                     "description": "Maximum range."
                  },
                  "qualities": {
                     "type": "array",
                     "description": "Weapon qualities.",
                     "items": {
                        "type": "object",
                        "properties": {
                           "name": {
                              "type": "string",
                              "description": "Quality name."
                           },
                           "ranks": {
                              "type": "integer",
                              "description": "Quality ranks."
                           },
                           "source": {
                              "type": "string",
                              "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                              "x-hb": { "span": 1 }
                           }
                        },
                        "required": [
                           "name"
                        ],
                        "optional": [
                           "value",
                           "source"
                        ],
                        "additionalProperties": false
                     }
                  },
                  "details": {
                     "type": "string",
                     "description": "Extra weapon details.",
                     "x-hb": { "span": "full" }
                  },
                  "description": {
                     "type": "string",
                     "description": "Deprecated. Shows book-style weapon text instead of a table.",
                     "x-hb": { "hidden": true }
                  }
               },
               "required": [
                  "name"
               ],
               "optional": [
                  "description",
                  "skill",
                  "damage",
                  "critical",
                  "range",
                  "qualities",
                  "details"
               ],
               "additionalProperties": false
            }
         },
         "abilities": {
            "type": "array",
            "description": "Vehicle abilities.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Ability name."
                  },
                  "description": {
                     "type": "string",
                     "description": "Ability text.",
                     "x-hb": { "span": "full" }
                  },
                  "children": {
                     "type": "array",
                     "description": "Sub-abilities, listed under this one.",
                     "items": {
                        "type": "object",
                        "properties": {
                           "name": {
                              "type": "string",
                              "description": "Ability name."
                           },
                           "description": {
                              "type": "string",
                              "description": "Ability text.",
                              "x-hb": { "span": "full" }
                           }
                        }
                     }
                  }
               },
               "required": [
                  "name"
               ],
               "optional": [
                  "description"
               ],
               "additionalProperties": false
            }
         },
         "description": {
            "$ref": "./varyingDisplay_sub_schema.json",
            "description": "Vehicle description."
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "silhouette",
         "maxSpeed",
         "handling",
         "defense",
         "armor",
         "htt",
         "sst",
         "controlSkill",
         "complement",
         "consumables",
         "encumbranceCapacity",
         "rarity",
         "description"
      ],
      "optional": [
         "page",
         "tribe",
         "variant",
         "hasVariants",
         "imageUrl",
         "passengers",
         "weapons",
         "abilities",
         "ftlRange",
         "ftlSpeed",
         "price",
         "restricted",
         "settings"
      ],
      "additionalProperties": false
   }
}