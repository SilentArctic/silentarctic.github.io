{
   "$id": "https://silentarctic.github.io/schemas/setting_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Setting name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "summary": {
            "type": "array",
            "description": "Setting summary.",
            "items": {
               "type": "string"
            }
         },
         "lore": {
            "$ref": "varyingDisplay_sub_schema.json",
            "description": "Detailed setting lore."
         },
         "codex": {
            "$ref": "varyingDisplay_sub_schema.json",
            "description": "Key people, places, and things."
         },
         "characterOptions": {
            "$ref": "varyingDisplay_sub_schema.json",
            "description": "Character creation options for this setting."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name"
      ],
      "optional": [
         "page",
         "summary",
         "lore",
         "codex",
         "characterOptions"
      ],
      "additionalProperties": false
   }
}