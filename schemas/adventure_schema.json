{
   "$id": "https://silentarctic.github.io/schemas/adventure_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Adventure name."
         },
         "chapters": {
            "$ref": "varyingDisplay_sub_schema.json",
            "description": "Adventure text. Usually one titled block per chapter."
         },
         "settings": {
            "$ref": "settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "chapters"
      ],
      "optional": [
         "settings"
      ],
      "additionalProperties": false
   }
}