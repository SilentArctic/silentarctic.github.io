{
   "$id": "https://silentarctic.github.io/schemas/specialization_schema.json",
   "$defs": {
      "talentRow": {
         "type": "array",
         "description": "Up to 4 talents, left to right.",
         "maxItems": 4,
         "items": {
            "type": "object",
            "properties": {
               "name": {
                  "type": "string",
                  "description": "Talent name."
               },
               "right": {
                  "title": "Connects right",
                  "type": "boolean",
                  "description": "Whether a line connects it to the talent on its right."
               },
               "down": {
                  "title": "Connects down",
                  "type": "boolean",
                  "description": "Whether a line connects it to the talent below."
               },
               "source": {
                  "type": "string",
                  "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                  "x-hb": { "span": 1 }
               }
            },
            "required": [
               "name"
            ],
            "optional": [
               "right",
               "down",
               "source"
            ],
            "additionalProperties": false
         }
      }
   },
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Specialization name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "imageUrl": {
            "title": "Image URL",
            "type": "string",
            "description": "URL of a related image.",
            "x-hb": { "span": "full" }
         },
         "career": {
            "type": "object",
            "description": "Career the specialization is for.",
            "properties": {
               "name": {
                  "type": "string",
                  "description": "Career name."
               },
               "source": {
                  "type": "string",
                  "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                  "x-hb": { "span": 1 }
               }
            },
            "required": [
               "name"
            ],
            "optional": [
               "source"
            ],
            "additionalProperties": false
         },
         "skills": {
            "type": "array",
            "description": "Skills added as career skills.",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Skill name."
                  },
                  "source": {
                     "type": "string",
                     "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                     "x-hb": { "span": 1 }
                  }
               },
               "required": [
                  "name"
               ],
               "optional": [
                  "source"
               ],
               "additionalProperties": false
            }
         },
         "talents": {
            "type": "object",
            "description": "Talent tree, top row first.",
            "properties": {
               "row1": {
                  "title": "Row 1",
                  "$ref": "#/$defs/talentRow"
               },
               "row2": {
                  "title": "Row 2",
                  "$ref": "#/$defs/talentRow"
               },
               "row3": {
                  "title": "Row 3",
                  "$ref": "#/$defs/talentRow"
               },
               "row4": {
                  "title": "Row 4",
                  "$ref": "#/$defs/talentRow"
               },
               "row5": {
                  "title": "Row 5",
                  "$ref": "#/$defs/talentRow"
               }
            }
         },
         "description": {
            "type": "array",
            "x-hb": { "widget": "paragraphs" },
            "description": "Specialization description.",
            "items": {
               "type": "string",
               "description": "Specialization description."
            }
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "talents"
      ],
      "optional": [
         "page",
         "imageUrl",
         "career",
         "skills",
         "description",
         "settings"
      ],
      "additionalProperties": false
   }
}