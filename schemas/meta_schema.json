{
   "$id": "https://silentarctic.github.io/schemas/meta_schema.json",
   "type": "object",
   "properties": {
      "source": {
         "type": "object",
         "description": "Identifies the content pack.",
         "properties": {
            "version": {
               "type": "string",
               "description": "Content pack version. The last update date works well (example: 2024.04.28).",
               "x-hb": { "span": 1 }
            },
            "json": {
               "type": "string",
               "description": "Unique kebab-case ID (example: my-homebrew). Must not match any other content pack. Only editable in a JSON editor.",
               "readOnly": true
            },
            "full": {
               "type": "string",
               "description": "Full content pack name."
            },
            "abbreviation": {
               "type": "string",
               "description": "Short name shown as the source and used in tags. Separate title and subtitle with a colon. Underscores are reserved for translation files.",
               "x-hb": { "span": 1 }
            },
            "language": {
               "type": "string",
               "description": "Language, spelled out (example: German). Defaults to English.",
               "x-hb": { "span": 1 }
            },
            "color": {
               "type": "string",
               "description": "Hex color for the abbreviation in tables and headers. Check it reads well in every theme. Defaults to black or white by theme.",
               "x-hb": { "widget": "color" }
            },
            "url": {
               "type": "string",
               "description": "Where to get the content pack (example: a DriveThruRPG page).",
               "x-hb": { "span": "full" }
            },
            "releaseDate": {
               "type": "string",
               "description": "Release date as D Month YYYY (example: 28 April 2023).",
               "x-hb": { "span": 1 }
            },
            "currentRelease": {
               "type": "object",
               "description": "The source release this conversion matches.",
               "properties": {
                  "version": {
                     "type": "string",
                     "description": "Source version this conversion matches (example: v2.2).",
                     "x-hb": { "span": 1 }
                  },
                  "date": {
                     "type": "string",
                     "description": "Source date this conversion matches.",
                     "x-hb": { "span": 1 }
                  }
               },
               "optional": [
                  "version",
                  "date"
               ]
            },
            "authors": {
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "Author name."
               },
               "description": "Authors."
            },
            "convertedBy": {
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "Name."
               },
               "description": "People who converted the source to GenesysRef JSON."
            },
            "translatedBy": {
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "Name."
               },
               "description": "Translators. Skip if the source itself was a translation."
            },
            "module": {
               "type": "boolean",
               "description": "Official modules only. When true, new users don't get the Core Collection by default."
            },
            "updateKey": {
               "type": "string",
               "description": "Premium content packs only. Generated automatically. Don't edit.",
               "x-hb": { "hidden": true }
            }
         },
         "required": [
            "json",
            "full",
            "abbreviation",
            "version",
            "authors"
         ],
         "optional": [
            "currentRelease",
            "color",
            "url",
            "convertedBy",
            "releaseDate",
            "module",
            "updateKey"
         ],
         "additionalProperties": false
      },
      "filters": {
         "type": "object",
         "description": "Custom values added to GenesysRef's list filters.",
         "properties": {
            "settings": {
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "New setting to add to filters."
               }
            },
            "magicSkills": {
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "New magic skill to add to filters."
               }
            },
            "optionFeatureType": {
               "title": "Option/feature type",
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "New option/feature type to add to filters."
               }
            },
            "optionFeatureClass": {
               "title": "Option/feature class",
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "New option/feature class to add to filters."
               }
            },
            "talentPrereqs": {
               "title": "Talent prerequisites",
               "type": "array",
               "items": {
                  "type": "string",
                  "description": "New talent prereq to add to filters."
               }
            }
         },
         "optional": [
            "settings",
            "magicSkills",
            "optionFeatureType",
            "optionFeatureClass"
         ],
         "additionalProperties": false
      },
      "defaultItemSettings": {
         "$ref": "settings_sub_schema.json",
         "description": "Settings (genres) for items without their own \"settings\". Leave empty for packs that span many settings, like the EPG."
      }
   },
   "required": [
      "source",
      "defaultItemSettings"
   ],
   "optional": [
      "filters"
   ],
   "additionalProperties": false
}