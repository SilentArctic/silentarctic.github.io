{
   "$id": "https://silentarctic.github.io/schemas/settings_sub_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Setting name (example: fantasy)."
         },
         "source": {
            "type": "string",
            "description": "Source abbreviation (example: CRB).",
            "x-hb": { "span": 1 }
         }
      },
      "required": [
         "name"
      ],
      "optional": [
         "source"
      ],
      "additionalProperties": false
   }
}