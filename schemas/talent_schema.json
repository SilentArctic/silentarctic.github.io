{
   "$id": "https://silentarctic.github.io/schemas/talent_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Talent name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "imageUrl": {
            "title": "Image URL",
            "type": "string",
            "description": "URL of a related image.",
            "x-hb": { "span": "full" }
         },
         "prerequisites": {
            "oneOf": [
               {
                  "title": "Yes / No",
                  "type": "boolean",
                  "description": "Whether the talent has prerequisites."
               },
               {
                  "title": "Named Prereqs",
                  "type": "array",
                  "description": "Specific prerequisites. Add new ones to _meta.filters.talentPrereqs.",
                  "items": {
                     "type": "string",
                     "description": "Prerequisite."
                  }
               }
            ]
         },
         "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Talent tier."
         },
         "activation": {
            "type": "string",
            "enum": [
               "passive",
               "active (incidental, out of turn)",
               "active (incidental)",
               "active (maneuver)",
               "active (action)"
            ],
            "description": "When and how the talent is used."
         },
         "ranked": {
            "type": "boolean",
            "description": "Whether the talent can be taken more than once."
         },
         "description": {
            "$ref": "./varyingDisplay_sub_schema.json",
            "description": "Talent description."
         },
         "tags": {
            "$ref": "talent_tags_sub_schema.json",
            "description": "Tags used for filtering."
         },
         "settings": {
            "$ref": "settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "tier",
         "activation",
         "ranked",
         "description"
      ],
      "optional": [
         "imageUrl",
         "page",
         "prerequisites",
         "settings",
         "tags"
      ],
      "additionalProperties": false
   }
}