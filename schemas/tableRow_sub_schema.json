{
   "$id": "https://silentarctic.github.io/schemas/tableRow_sub_schema.json",
   "oneOf": [
      {
         "type": "object",
         "title": "Subtitle",
         "description": "Full-width shaded row that splits the table into sections.",
         "properties": {
            "subtitle": {
               "type": "string",
               "description": "Subtitle text."
            }
         },
         "required": [
            "subtitle"
         ],
         "additionalProperties": false
      },
      {
         "type": "object",
         "title": "Row",
         "description": "Cells keyed by column value (or header, if the column has no value).",
         "propertyNames": {
            "not": { "const": "subtitle" }
         },
         "additionalProperties": {
            "type": ["string", "number", "array"],
            "items": {
               "type": "string"
            },
            "description": "Cell content."
         }
      }
   ]
}
