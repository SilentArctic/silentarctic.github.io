{
   "$id": "https://silentarctic.github.io/schemas/skill_schema.json",
   "type": "array",
   "items": {
      "type": "object",
      "properties": {
         "name": {
            "type": "string",
            "description": "Skill name."
         },
         "page": {
            "type": "integer",
            "description": "Source page number."
         },
         "characteristic": {
            "type": "string",
            "description": "Characteristic linked to the skill.",
            "x-hb": { "span": 1 }
         },
         "category": {
            "type": "string",
            "enum": [
               "general",
               "combat",
               "social",
               "knowledge",
               "magic",
               "other"
            ],
            "description": "Skill category, used for grouping and filtering."
         },
         "imageUrl": {
            "title": "Image URL",
            "type": "string",
            "description": "URL of a related image.",
            "x-hb": { "span": "full" }
         },
         "description": {
            "$ref": "./varyingDisplay_sub_schema.json",
            "description": "Skill description."
         },
         "shouldUse": {
            "type": "array",
            "items": {
               "type": "string"
            },
            "description": "Examples of when to use the skill."
         },
         "shouldNotUse": {
            "type": "array",
            "items": {
               "type": "string"
            },
            "description": "Examples of when not to use the skill."
         },
         "spells": {
            "type": "array",
            "items": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string",
                     "description": "Spell name."
                  },
                  "source": {
                     "type": "string",
                     "description": "Source abbreviation (example: CRB). Omit if it's in this content pack.",
                     "x-hb": { "span": 1 }
                  }
               },
               "required": [
                  "name"
               ],
               "optional": [
                  "source"
               ],
               "additionalProperties": false
            },
            "description": "Spells cast with this skill."
         },
         "settings": {
            "$ref": "./settings_sub_schema.json",
            "description": "Settings (genres) this item belongs to. Overrides the content pack's defaultItemSettings."
         },
         "id": {
            "type": "string",
            "description": "Generated automatically. Don't edit.",
            "x-hb": { "hidden": true }
         }
      },
      "required": [
         "name",
         "characteristic",
         "category",
         "description",
         "shouldUse",
         "shouldNotUse"
      ],
      "optional": [
         "imageUrl",
         "page",
         "spells",
         "settings"
      ],
      "additionalProperties": false
   }
}